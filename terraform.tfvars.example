# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
aws_region         = "ap-southeast-1"
alert_email        = "you@example.com"
monthly_budget_usd = 20
environment        = "dev"

# Your public IP, to hit the app directly before the ALB works (then remove):
# app_direct_cidrs = ["x.x.x.x/32"]

# Only if your app repo's build files hardcode CodeArtifact names (default: nextwork-domain / nextwork-repo):
# codeartifact_domain_name     = "nextwork"
# codeartifact_repository_name = "nextwork-devops-cicd"

# Optional SSH (default: none - use SSM Session Manager):
# ssh_cidr = "x.x.x.x/32"
# key_name = "my-key-pair"

# Usually leave these at their defaults:
# name_prefix       = "nextwork"
# instance_type     = "t3.micro"
# tomcat_version    = "9.0.109"
# github_repo       = "CedsCode/nextwork-web-project"
# github_branch     = "main"
# app_port          = 8080
# health_check_path = "/nextwork-web-project/"
# alb_ingress_cidrs = ["0.0.0.0/0"]
# alarm_period      = 60
# budget_notification_thresholds = [50, 80, 100]
